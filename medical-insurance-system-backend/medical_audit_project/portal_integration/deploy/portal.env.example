# Merge into the CURRENT backend .env; never replace the full production file.
# Keep existing database values, DJANGO_SECRET_KEY, app ID and real SM2 keys.
# Backend and celery already use env_file: .env in the confirmed deployment.
PORTAL_AUTH_MODE=existing
# Default false. Only applies to existing mode. Set true to provision a same-name
# normal, non-admin account with an unusable password after valid portal SSO.
# Uses existing auth_user/AccountProfile tables; no schema migration is required.
# Existing passwords, names, roles and activation state are preserved.
# Missing AccountProfile is created with normal role; disabled users stay denied.
# The supplied portal-302.env enables this for the requested deployment.
PORTAL_AUTO_CREATE_USERS=false
LEGACY_DATABASE_COMPATIBILITY=true

# Confirmed from the 302 request records supplied on 2026-10-20.
PORTAL_BASE_URL=http://10.130.76.194
PORTAL_CAS_LOGIN_URL=http://10.130.76.194/ucenter/uinfo/cas/js/login
PORTAL_FRONTEND_URL=https://10.130.76.47:8088/yibao
PORTAL_LOGIN_CALLBACK_URL="https://10.130.76.47:8088/yibao/#/auth/sso"
SSO_PORTAL_HOME_URL="http://10.130.76.194//home/#/home-page"

# Keep the live PORTAL_APP_ID if present. The historical jicheng ID below is
# only a reference; enable it ONLY after matching appid in the actual 302.
# PORTAL_APP_ID=6E7aymY5E33X-qGK7NL6qKtn_oYNDZb0CVS7uHLx

# Defaults already used by the code; do not append /api to PORTAL_BASE_URL.
# PORTAL_SSO_VALIDATE_PATH=/api/security-manage-permission/app/cas/serviceValidate
# PORTAL_USER_DETAIL_PATH=/api/security-manage-permission/v1/user/info
# PORTAL_REQUEST_TIMEOUT_SECONDS=10

# Keep real registered keys. Do not uncomment these placeholders or replace
# production keys with the example keys in the PDF.
# PORTAL_PUBLIC_KEY=<portal public key>
# PORTAL_APP_PUBLIC_KEY=<registered application public key>
# PORTAL_APP_PRIVATE_KEY=<matching application private key>
# Missing expired in serviceValidate requires the encrypted user-detail lookup
# and therefore the three real SM2 keys even in existing-account mode.

# Match these options to the registered action encryption setting if using the
# separate database-backed synchronization mode; do not change them blindly.
# PORTAL_ENCRYPT_ENABLED=true
# PORTAL_ALLOW_PLAINTEXT=false

# Existing-account mode does not support portal user/permission synchronization
# or immediate portal revocation. Do not configure synchronization callbacks for
# this mode. Logout URLs are not established by the login 302 records; preserve
# existing verified values instead of guessing them.
